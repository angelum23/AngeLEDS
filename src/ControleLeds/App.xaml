<Application x:Class="ControleLeds.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="Fundo" Color="#15171C"/>
        <SolidColorBrush x:Key="Painel" Color="#1D2027"/>
        <SolidColorBrush x:Key="Borda" Color="#343843"/>
        <SolidColorBrush x:Key="Texto" Color="#E7E9EE"/>
        <SolidColorBrush x:Key="TextoFraco" Color="#9097A6"/>
        <SolidColorBrush x:Key="Destaque" Color="#378ADD"/>
        <SolidColorBrush x:Key="LedApagado" Color="#2A2D35"/>
        <SolidColorBrush x:Key="BotaoFundo" Color="#262A33"/>
        <SolidColorBrush x:Key="LedApagadoAnel" Color="#3A3F4B"/>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Texto}"/>
        </Style>

        <Style x:Key="Botao" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Texto}"/>
            <Setter Property="Background" Value="{StaticResource BotaoFundo}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Borda}"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Destaque}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="b" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BotaoPrincipal" TargetType="Button" BasedOn="{StaticResource Botao}">
            <Setter Property="Background" Value="#1E4F86"/>
            <Setter Property="BorderBrush" Value="#378ADD"/>
        </Style>

        <Style x:Key="Amostra" TargetType="Button">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="15"
                                BorderThickness="2" BorderBrush="{TemplateBinding BorderBrush}"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="BorderBrush" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Rotulo" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextoFraco}"/>
            <Setter Property="FontSize" Value="9"/>
        </Style>

        <Style x:Key="Secao" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextoFraco}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,18,0,8"/>
        </Style>
    </Application.Resources>
</Application>
